# Copia este archivo como .env y completa los valores.
# Solo necesitas configurar UN proveedor de LLM (el que prefieras usar).

# --- Proveedor de embeddings y LLM ---
# Opciones soportadas: "openai", "cohere", "gemini", "none"
# "none" activa el modo demo local (sin llamadas a API, respuestas extractivas).
LLM_PROVIDER=none

# --- OpenAI (si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Cohere (si LLM_PROVIDER=cohere) ---
COHERE_API_KEY=
# command-r fue retirado (sept. 2025). Modelo vigente recomendado:
COHERE_MODEL=command-a-03-2025

# --- Google Gemini (si LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=

# --- Configuración general del agente ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# --- Rutas ---
DOCUMENTS_DIR=documents
VECTOR_DB_DIR=chroma_db

# --- Almacenamiento de documentos ---
# "local": guarda los archivos subidos en el sistema de archivos de la app
#          (se pierden si Streamlit Cloud reinicia/redepliega el contenedor).
# "oci":   usa OCI Object Storage (capa Always Free: 20 GB) como
#          almacenamiento persistente. El bucket se crea a mano desde la
#          consola de OCI (no se usa Terraform). Requiere las variables
#          de abajo y, o bien tener ~/.oci/config configurado (igual que
#          la CLI de OCI), o las variables OCI_TENANCY_OCID/OCI_USER_OCID/
#          OCI_FINGERPRINT/OCI_PRIVATE_KEY_CONTENT/OCI_REGION si prefieres
#          no usar un archivo de config (más cómodo para secrets de
#          Streamlit Cloud).
STORAGE_BACKEND=local
OCI_BUCKET_NAME=
OCI_NAMESPACE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_CONTENT=
OCI_REGION=mx-queretaro-1
